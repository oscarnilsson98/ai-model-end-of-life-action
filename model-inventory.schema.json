{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oscarnilsson98/ai-model-end-of-life-action/raw/main/model-inventory.schema.json",
  "title": "AI model end-of-life inventory",
  "description": "Models checked by oscarnilsson98/ai-model-end-of-life-action.",
  "type": "array",
  "minItems": 1,
  "maxItems": 1000,
  "items": {
    "oneOf": [
      {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F])[\\s\\S]*\\S[\\s\\S]*$"
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F])[\\s\\S]*\\S[\\s\\S]*$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Serving-platform label. Runtime validation additionally requires at least one Unicode letter or number.",
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F])[\\s\\S]*\\S[\\s\\S]*$"
          }
        }
      }
    ]
  }
}
